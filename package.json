{
  "name": "dsh-store-ops-expert",
  "version": "0.1.2",
  "description": "Restaurant store operations expert for DeepSeek Harness: bundled skills plus a single-file local-data dashboard.",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igdwei/dsh-store-ops-expert.git"
  },
  "homepage": "https://github.com/igdwei/dsh-store-ops-expert#readme",
  "bugs": {
    "url": "https://github.com/igdwei/dsh-store-ops-expert/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "restaurant",
    "analytics",
    "dashboard"
  ],
  "author": "igdwei",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/**",
    "screenshots.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "*"
  },
  "license": "MIT"
}
